        font-size: 15px;
    }

    #fixedActionButton>.ec-base-button[class*="gColumn"] {
        border: 0;
        padding: 0;
    }

    .detailArea #totalProducts tr {
        position: relative;
    }

    .detailArea #totalProducts td {
        font-size: .9rem;
    }

    .detailArea #totalProducts .delete,
    .detailArea #totalProducts .option_box_del {
        position: absolute;
        right: 14px;
        display: block;
        margin: 0;
        padding: 0;
        top: 0;
        margin-top: 1rem;
    }

    .detailArea #totalProducts .option_box_del {
        content: url(//img.echosting.cafe24.com/skin/skin/product/ico_product_delete.svg);
    }

    .detailArea #totalProducts tbody>tr {
        background: #f9f9f9;
    }

    .detailArea #totalProducts tbody>tr.option_product,
    .detailArea #totalProducts tbody>tr.add_product {
        border-bottom: 5px solid #fff;
        border-top: 5px solid #fff;
    }

    .detailArea #totalProducts table .right {
        text-align: left;
    }

    .detailArea #totalProducts>table>tbody>tr#totalProductsOption>td:first-child {
        border-top: 5px solid #fff;
        padding: 0;
    }

    .detailArea #totalProducts tbody td,
    .detailArea #totalProducts>table>tbody>tr:first-child>td {
        border: 0;
        padding: 0 15px;
    }

    .detailArea #totalProducts>table>tbody>tr>td:first-child {
        padding: .7rem .8rem .7rem .8rem;
        display: block;
    }

    .detailArea #totalProducts tbody>tr>td:nth-child(2) {
        display: inline-block;
        width: 50%;
        vertical-align: middle;
    }

    .detailArea #totalProducts tbody>tr>td:nth-child(3) {
        text-align: right;
        display: inline-block;
        width: 50%;
        vertical-align: middle;
    }

    .detailArea #totalProducts tbody td.right,
    .detailArea #totalProducts>table>tbody>tr:first-child>td.right {
        padding-top: 10px;
        padding-bottom: 10px;
        border: 0;
        padding: 10px 15px;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product {
        background: #f9f9f9;
        display: block;
    }

    /* 옵션 선택 시 닫기 및 옵션에 대한 금액 표시되지 않는 부분 수정 (wy.230706) */
    .detailArea #totalProducts>table>tbody>tr.option_product>td.right {
        position: absolute;
        bottom: 10px;
        right: 0;
        text-align: right;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>td:nth-child(2).right,
    .detailArea #totalProducts>table>tbody>tr.add_product>td:nth-child(2).right,
    .detailArea #totalProducts>table>tbody>tr.option_product>td:nth-child(3).right {
        bottom: 5px;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>td:nth-child(3) {
        text-align: right;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>td:nth-child(3).center,
    .detailArea #totalProducts>table>tbody>tr.add_product>td:nth-child(3).center {
        display: block;
        padding: 0;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>input+td:nth-child(3) {
        text-align: left;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>td>p.product,
    .detailArea #totalProducts>table>tbody>tr.add_product>td>p.product {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-right: 20px
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>td>p.product+p,
    .detailArea #totalProducts>table>tbody>tr.add_product>td>p.product+p {
        margin: 0;
        padding-bottom: 10px;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>td>p.product strong,
    .detailArea #totalProducts>table>tbody>tr.add_product>td>p.product strong {
        font-weight: normal;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>td>table,
    .detailArea #totalProducts>table>tbody>tr.option_product>td>table tbody,
    .detailArea #totalProducts>table>tbody>tr.option_product>td>table tr {
        display: block;
        width: 100%;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>td>table td {
        padding: 0;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>td>table td:first-child {
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>td>table td.right {
        padding: 10px 0;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>td>table td .delete {
        right: 0;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>td .option {
        display: block;
    }

    .detailArea #totalProducts>table>tbody>tr.option_product>td .option>td {
        width: 100vw;
    }

    .detailArea #totalProducts tbody>tr.add_product {
        display: block;
    }

    /* 옵션 선택 시 닫기 및 옵션에 대한 금액 표시되지 않는 부분 수정 (wy.230706) */
    .detailArea #totalProducts>table>tbody>tr.add_product>td,
    .detailArea #totalProducts>table>tbody>tr.add_product>td:first-child {
        padding: 0 15px;
    }

    .detailArea #totalProducts>table>tbody>tr.add_product>td .product {
        padding-right: 15px;
    }

    .detailArea #totalProducts>table>tbody>tr.add_product>td.right {
        padding: 10px 15px;
        position: absolute;
        bottom: 10px;
        right: 0;
        text-align: right;
    }

    .detailArea #totalProducts .quantity {
        padding-bottom: 10px;
    }

    .detailArea #totalProducts tr.option>td>table th,
    .detailArea #totalProducts tr.option>td>table td {
        display: block;
        width: 100%;
        font-size: .9rem;
    }

    .detailArea #totalProducts tr.option>td>table th {
        padding-top: 10px;
    }

    .detailArea #totalProducts tr.option .xans-product-addoption>td {
        padding: 0 0 10px;
    }

    .detailArea #totalProducts tr.option>td>table td {
        padding: 0 0 10px;
    }

    .detailArea #totalProducts tr.add_product>td>table tr:first-child th,
    .detailArea #totalProducts tr.add_product>td>table tr:first-child td {
        width: 100%;
    }

    .detailArea #totalProducts tbody tr.xans-product-addoption>th {
        padding: .7rem 0;
    }

    .detailArea #totalProducts tbody td .mileage {
        display: inline-block;
    }

    .detailArea #totalProducts p.product span {
        font-size: 12px;
    }

    .xans-product-detail .discountMember>li {
        position: static;
    }

    .xans-product-detail .btnTooltip {
        position: static;
    }

    .differentialShipping {
        left: 0;
        right: 0;
        width: 88%;
        margin: 10px auto 0;
    }

    .xans-product-detail .productSet>.title {
        padding: 0;
    }

    .xans-product-detail .productSet>.title h3 {
        font-size: 1rem;
        padding: 0 1rem;
    }

    /* .xans-product-detail .productSet.additional .product {max-height: 19rem;overflow-y: auto;} */
    .xans-product-detail .productSet.additional .btn-toggle {
        top: 0;
        right: 0;
        left: 0;
        height: 3.3rem;
        width: 100%;
    }

    .xans-product-detail .productSet.additional .btn-toggle .icon {
        position: absolute;
        right: 1.2rem;
        top: 1.2rem;
    }

    .xans-product-detail .productSet>.title h3>.txtInfo {
        display: none;
    }

    .xans-product-detail .productSet .thumbnail {
        position: absolute;
        top: 15px;
        left: 15px;
        z-index: 1;
        width: 53px;
    }

    .xans-product-detail .productSet .thumbnail img {
        max-width: 100%;
        border: 1px solid #ededed;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        box-sizing: border-box;
    }

    .xans-product-detail .productSet .information {
        position: relative;
        padding: 15px 15px 0 83px;
    }

    .xans-product-detail .productSet .information .name {
        font-size: 1rem;
        line-height: 1.3;
    }

    .xans-product-detail .productSet .option {
        padding: 5px 15px 0 83px;
        color: #888;
        font-size: 0.9rem;
    }

    #optionG .wp-opt-box {
        margin-top: 1rem;
    }

    #optionG .wp-opt-box2 {
        margin-top: 1rem;
    }

    #optionG.active .inner {
        border-top: 0px;
        padding: 0;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 999;
        background: #fff;
        width: 100%;
        box-sizing: border-box;
        font-size: 0;
    }

    #optionG.active .inner .btn-extend {
        display: block;
        text-align: center;
        margin: 0 auto;
        line-height: 0;
        font-size: 0;
        text-decoration: none;
        position: absolute;
        top: auto;
        bottom: 0;
        left: 0;
        right: 0;
        margin: 0;
        width: 100%;
        height: 3.5rem;
        border: 0;
        border-radius: 0;
        background: none;
        -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    }

    #optionG.active .inner .btn-extend:after {
        font-family: swiper-icons;
        font-size: var(--swiper-navigation-size);
        text-transform: none !important;
        letter-spacing: 0;
        text-transform: none;
        font-variant: initial;
        content: 'next';
        transform: rotate(270deg);
        display: block;
        font-size: 1rem;
        padding: 0 0 0px 1.4rem;
        transition: all .25s ease;
        font-weight: bold;
    }

    #optionG.active .inner .btn-extend:after {
        display: none;
    }

    #optionG.active .inner.opt-active .btn-extend:after {
        transform: rotate(90deg);
    }

    #optionG.active .wp-opt-box {
        display: flex;
        justify-content: space-between;
        min-height: 20px;
        margin: 0;
        flex-direction: column;
    }

    #optionG.active .wp-opt-box .opt-left {
        padding: 0 0;
        margin: 1rem 1rem 0;
    }

    #optionG.active .wp-opt-box .opt-right {
        margin: 1rem 1rem;
    }

    #optionG.active .wp-opt-box2 {
        flex-direction: column;
        margin: 0;
    }

    #optionG.active .wp-opt-box2 #prodName {
        font-size: 0;
    }

    #optionG.active .wp-opt-box3 {
        display: flex;
        width: 100%;
        flex-direction: column;
    }

    #optionG.active .xans-product-action.productAction {
        margin: 0;
    }

    #optionG.active .xans-product-action .ec-base-button[class*="gColumn"] {
        border: 0;
        padding: 0;
        margin: 0;
    }

    #optionG.active .xans-product-action .ec-base-button[class*="gColumn"] [class^='btn'] {
        flex: 1;
        height: 3.5rem;
        line-height: 3.5rem;
        font-size: 1.1rem;
        margin: 0 0 0;
        border-radius: 0;
        border-left: 0;
        border-right: 0;
        border-bottom: 0;
        border-color: #ddd;
    }

    #optionG.active .xans-product-action .ec-base-button[class*="gColumn"] [class^='btnStrong'] {
        margin: 0;
    }

    #optionG.active .xans-product-action .ec-base-button[class*="gColumn"] [class^='btnEm'] {
        margin: 0;
    }

    #optionG.active #totalPrice {
        padding: 1rem 0;
        display: none;
    }

    #optionG.active #totalPrice .title {
        font-size: 1.1rem;
    }

    #optionG.active.extend .inner {
        border-top: 1px solid #ccc;
    }

    #optionG.active.extend .wp-opt-area {
        max-height: calc(90vh - 110px);
        overflow: hidden auto;
    }

    #optionG.active.extend .inner .btn-extend {
        display: block;
        top: -1.6rem;
        height: 1.6rem;
        width: 6rem;
        left: 50%;
        margin-left: -3rem;
        background: #fff;
        border-radius: 8px 8px 0 0;
    }

    #optionG.active.extend .inner .btn-extend:after {
        transform: rotate(90deg);
        width: 0;
        margin: 0 auto;
        display: inline-block;
    }

    #optionG.active.extend #totalPrice {
        display: block;
        padding: 5px 10px;
        text-align: right;
    }

    #optionG.active.extend #totalPrice * {
        line-height: 26px;
    }

    .naver-kakao-pay {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        text-align: center;
    }

    /* App payment button box */
    #appPaymentButtonBox .wp-sample,
    #appPaymentButtonBox #kakao-checkout-button {
        text-align: center;
        margin-top: 10px;
    }

    /*231212 - 배경 모달창 추가*/
    #optionG.active.extend:before {
        content: '';
        width: 100%;
        height: 100%;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 998;
        background: rgba(0, 0, 0, 0.3);
    }

    .supplyInfo {
        margin: 0 1rem;
    }

    .supplyInfo th,
    .supplyInfo td {
        font-size: 1rem !important;
        padding: 10px !important;
    }

    #footer {
        padding-bottom: 4rem;
    }

    #wrap .bottom-nav {
        bottom: 5rem;
    }
}

@media all and (max-width:618px) {

    #NaverChk_Button,
    #appPaymentButtonBox {
        width: 100%;
    }

    .naver-kakao-pay .wp-sample img {
        max-width: 100%;
    }
}


/* 하단 고정 구매바/옵션창 상태일 때만 브이리뷰 숨김 */
#optionG.active [class*="vreview"],
#optionG.active [id*="vreview"] { display: none !important; }